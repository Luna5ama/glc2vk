{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-vs2022",
            "displayName": "Windows x64 (Visual Studio 2022)",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/out/build",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
                "VCPKG_TARGET_TRIPLET": "x64-windows-static-md-v143"
            }
        },
        {
            "name": "windows-clang-sanitizers",
            "displayName": "Windows x64 (Clang ASan/UBSan)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/asan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
                "VIBRIS_ENABLE_SANITIZERS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "release",
            "configurePreset": "windows-vs2022",
            "configuration": "Release"
        },
        {
            "name": "sanitizers",
            "configurePreset": "windows-clang-sanitizers"
        }
    ],
    "testPresets": [
        {
            "name": "release",
            "configurePreset": "windows-vs2022",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "sanitizers",
            "configurePreset": "windows-clang-sanitizers",
            "filter": {
                "include": {
                    "name": "StdioLifecycle|GrpcReconnect|SourceSoak"
                }
            },
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
